# The planner and verifier read no environment variables. The lab scripts accept these:

# Where lab/agent.sh writes the Docker Agent transcript (default: a temporary file).
# SOLAR_AGENT_TRANSCRIPT=/tmp/solar-agent.ndjson

# Where lab/record.sh writes its evidence (default: docs/evidence/<date>-local.md).
# SOLAR_EVIDENCE=docs/evidence/local.md
